# Copy to .env. This file is read by BOTH docker compose (host port mapping)
# and the Go services / Makefile (connection strings). Keep the *_PORT values
# and the URLs below in sync.
#
# Ports are shifted off the defaults (5432/6379/9092) so the stack coexists
# with anything already running on this machine. If one of these is also taken,
# change the PORT and the matching URL together.

POSTGRES_PORT=5433
REDIS_PORT=6380
KAFKA_PORT=29092

HTTP_ADDR=:8080
DATABASE_URL=postgres://chat:chat@localhost:5433/chat?sslmode=disable
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=dev-secret-change-me
JWT_ISSUER=chat-platform

# Kafka (comma-separated brokers). Both cmd/gateway and cmd/chat need these.
KAFKA_BROKERS=localhost:29092
KAFKA_PARTITIONS=12

SESSION_TTL=30s
HEARTBEAT_INTERVAL=10s
WRITE_TIMEOUT=10s
SEND_BUFFER=64

# GATEWAY_ID defaults to the hostname.
# GATEWAY_ID=gateway-local

# DEV_MODE mounts POST /v1/dev/token and relaxes WebSocket origin checks.
DEV_MODE=true
